# ============================================================
# SOYBEANCARE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Flask Server Config
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production
JWT_SECRET=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# CORS Allowed Origins (comma-separated or * for local dev)
FRONTEND_ORIGIN=https://soybeancare-frontend.onrender.com
CORS_ORIGINS=https://soybeancare-frontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Database Config
DATABASE_PATH=soybeancare.db

# Groq Vision & LLM API (Soybean Leaf Verification & Advisory)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Roboflow Disease Classification Model
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=soybean-crop-disease/6

# Prediction Confidence Thresholds
MIN_PREDICTION_CONFIDENCE=0.50
SOYBEAN_DETECTOR_MIN_CONFIDENCE=0.75

# Google & Apple Authentication (Optional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Administrator provisioning
# Create the first administrator interactively from the backend directory:
# python manage.py create-admin --name "SoybeanCare Administrator" --email "admin@example.com"
# The CLI securely prompts for the password; do not put admin credentials in this file.
# Reset an existing admin password without changing roles: python manage.py reset-admin-password --email "admin@example.com"
